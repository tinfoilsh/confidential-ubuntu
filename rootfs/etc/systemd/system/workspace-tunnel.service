[Unit]
Description=Workspace reverse SSH tunnel
After=ssh.service network.target
Wants=ssh.service
ConditionPathExists=/run/workspace/tunnel.conf
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/bin/ssh -NT -F /run/workspace/tunnel.conf workspace-tunnel
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
