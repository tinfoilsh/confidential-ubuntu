#!/usr/bin/python3
import hashlib, os, socket, subprocess, sys

DISK = "/mnt/disk"
CONTROL = "/run/tinfoil/volumes/workspace/control.sock"
PERSIST = ["/root"]
MAX_REPLY_BYTES = 256
FORMAT = b"\x02"
# Volumes created by earlier releases use this format and a hashed key.
LEGACY_FORMAT = b"\x01"
INITIALIZE = b"i"
UNLOCK = b"u"


def ask(version, op, key):
    with socket.socket(socket.AF_UNIX, socket.SOCK_SEQPACKET) as s:
        s.connect(CONTROL)
        s.sendall(version + op + key)
        return s.recv(MAX_REPLY_BYTES).decode("ascii")


if os.path.exists(CONTROL):
    key = sys.stdin.buffer.read()
    # The worker formats only a blank volume and rejects initializing any other.
    status = ask(FORMAT, INITIALIZE, key)
    if status == "rejected":
        status = ask(FORMAT, UNLOCK, key)
    if status == "failed":
        status = ask(LEGACY_FORMAT, UNLOCK, hashlib.sha512(key).digest())
    if status != "ok":
        sys.exit(f"workspace-unlock: volume worker answered {status}")
    print("Volume unlocked.")
for path in PERSIST:
    if not os.path.exists(DISK + path):
        subprocess.run(["cp", "-a", "--parents", path, DISK], check=True)
    if not os.path.ismount(path):
        subprocess.run(["mount", "--bind", DISK + path, path], check=True)
