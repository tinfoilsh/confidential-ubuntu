#!/usr/bin/python3
import hashlib, os, socket, subprocess, sys

DISK = "/mnt/disk"
CONTROL = "/run/tinfoil/volumes/workspace/control.sock"
PERSIST = ["/root"]
MAX_REPLY_BYTES = 256


def unlock(key):
    with socket.socket(socket.AF_UNIX, socket.SOCK_SEQPACKET) as s:
        s.connect(CONTROL)
        # Format 1 unlocks existing HKDF volumes; it cannot initialize a disk.
        s.sendall(b"\x01u" + key)
        return s.recv(MAX_REPLY_BYTES).decode()


if os.path.exists(CONTROL):
    key = hashlib.sha512(sys.stdin.buffer.read()).digest()
    status = unlock(key)
    if status != "ok":
        sys.exit(f"workspace-unlock: volume worker answered {status}")
    print("Volume unlocked.")
for path in PERSIST:
    if not os.path.exists(DISK + path):
        subprocess.run(["cp", "-a", "--parents", path, DISK], check=True)
    if not os.path.ismount(path):
        subprocess.run(["mount", "--bind", DISK + path, path], check=True)
