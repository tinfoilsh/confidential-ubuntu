#!/bin/bash
set -euo pipefail
if [[ $EUID != 0 || $# != 1 || ${1:-} != --on-next-boot ]]; then
    printf 'usage: sudo workspace-reset --on-next-boot\nNext boot archives the current OS and seeds the deployed image. /workspace and Docker data are retained.\n' >&2
    exit 2
fi
mountpoint -q /mnt/disk
umask 077
touch /mnt/disk/.reset-rootfs
sync -f /mnt/disk
printf 'OS reset scheduled. Run sudo reboot when ready.\n'
