cvm-version: "0.15.4-rc.1+gpu@sha256:50f772fee6e6e72b81e4c100395cc40dec4463a677d8d22828dfda42b4c49e0f"
cpus: 120
memory: 1048576
gpus: 8

cvm-network:
  inbound-ports: [22]

attested-keys:
  - id: host-ssh
    key: ecdsa-p256
  - id: teleport-join
    key: ed25519

networks:
  dev:
    egress: open

volumes:
  - name: workspace
    exec: true

containers:
  - name: workspace
    image: null # Set by each release to its image digest.
    runtime: nvidia
    gpus: all
    restart: on-failure
    cvm_admin: true
    stop_timeout: 120
    networks: [dev]
    persistent_volumes: [workspace:/mnt/disk]
    keys: [host-ssh, teleport-join]
    ports: ["22:22"]
    env:
      - SSH_KEYS: null # Required: quoted public key, or a YAML block for multiple keys.
      # Optional: quoted Teleport proxy address (host:port) to enroll with.
      # - TELEPORT_PROXY: "teleport.example.com:443"
      # Optional: quoted `tailscale up` options; setting them enables Tailscale.
      # Send the auth key to `tailscale-join` over SSH, never through this file.
      # - TAILSCALE_UP_ARGS: "--hostname=my-sandbox"
    tmpfs:
      /run: "rw,nosuid,nodev,mode=755"
    healthcheck:
      test: ["CMD", "/healthcheck.sh"]
      interval: 5s
      timeout: 5s
      retries: 12
      start_period: 30s

shim:
  upstream-port: 22
  # Shut the guest down gracefully on stop so unflushed volume writes are kept.
  drain_connections: true
